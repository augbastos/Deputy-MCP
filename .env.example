# Deputy MCP configuration. Copy to `.env`, fill in ONE authentication mode, and never
# commit the result: it holds secrets.
#
# The server reads this file from the working directory, or from the path in
# DEPUTY_ENV_FILE. Real environment variables always win. A `.env` picked up from the
# working directory cannot set DEPUTY_ALLOW_WRITES, DEPUTY_ALLOW_CUSTOM_HOST or
# DEPUTY_TOKEN_STORE; set those in the environment or in a file named by DEPUTY_ENV_FILE.

# =============================================================================
# 1. API token: every tool. Creating a token needs an admin access level in Deputy.
#    Business settings -> Integrations -> API access -> New OAuth Client ->
#    Get an Access Token (shown once).
# =============================================================================
DEPUTY_API_TOKEN=your-deputy-api-token

# The address you see when signed in: https://{install}.{geo}.deputy.com
# A trailing slash or /api/v1 is accepted and normalised away.
DEPUTY_BASE_URL=https://your-company.eu.deputy.com

# =============================================================================
# 2. OAuth 2.0: every tool, for any employee (no admin needed).
#    Register a personal app at https://once.deputy.com/my/oauth_clients with the
#    redirect URI http://localhost:8823/callback, then run `deputy-mcp login`.
#    Leave DEPUTY_API_TOKEN unset: an API token takes precedence over OAuth.
# =============================================================================
# DEPUTY_OAUTH_CLIENT_ID=your-oauth-client-id
# DEPUTY_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Loopback port of the redirect URI registered above. Default: 8823.
# DEPUTY_OAUTH_REDIRECT_PORT=8823

# Tokens from `deputy-mcp login` are kept in the OS keychain (Windows Credential
# Manager, macOS Keychain, Secret Service on Linux). Only where no keychain exists,
# such as a container, point this at a file instead; it is plaintext, created
# owner-only where the OS supports it.
# DEPUTY_TOKEN_STORE=/data/deputy-mcp/token.json

# =============================================================================
# 3. iCal feed: your own roster only, no token, read-only.
#    Deputy -> My Schedule -> Subscribe / Export to calendar -> copy the link.
#    The link contains a private token: treat it as a password.
#    Leave the API token and OAuth settings unset.
# =============================================================================
# DEPUTY_CALENDAR_URL=https://your-company.eu.deputy.com/exec/ical/xxxxxxxx/My_Roster.ics

# =============================================================================
# Optional settings
# =============================================================================

# Register the write tools (claim open shift, swap request, unavailability,
# clock in/out). API token and OAuth modes only. Default: false.
DEPUTY_ALLOW_WRITES=false

# Allow an install host outside *.deputy.com (enterprise custom domains only).
# Unknown hosts fail closed so a typo cannot send the token elsewhere. Default: false.
DEPUTY_ALLOW_CUSTOM_HOST=false

# Read cache lifetime in seconds; 0 disables caching. Default: 30.
DEPUTY_CACHE_TTL=30

# Per-request HTTP timeout in seconds. Default: 30.
DEPUTY_TIMEOUT=30

# Retries for idempotent requests on 429, 502-504 and timeouts. Writes never retry.
# Default: 3.
DEPUTY_MAX_RETRIES=3
